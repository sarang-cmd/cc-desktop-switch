#!/bin/sh
set -eu

BUNDLE_ID="io.github.lonr6.ccdesktopswitch"
for EXECUTABLE_NAME in Junction CC-Desktop-Switch; do
  if /usr/bin/pgrep -x "$EXECUTABLE_NAME" >/dev/null 2>&1; then
    /usr/bin/osascript -e "tell application id \"$BUNDLE_ID\" to quit" >/dev/null 2>&1 || true
    /bin/sleep 2
    /usr/bin/pkill -x "$EXECUTABLE_NAME" >/dev/null 2>&1 || true
  fi
done

# Remove the previous branded bundle and the current bundle before installing the package.
/bin/rm -rf "/Applications/Junction.app" "/Applications/CC Desktop Switch.app"
exit 0
